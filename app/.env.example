PORT=3001
JWT_SECRET=your_jwt_secret_change_in_production
NODE_ENV=development

# OAuth Configuration (optional - leave blank to disable)
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Get these from: https://developers.facebook.com/apps/
FACEBOOK_APP_ID=

# Get these from: https://www.linkedin.com/developers/apps/
# Sign In with LinkedIn using OpenID Connect
# Scopes required: openid, profile, email
# Add callback URL: https://yourdomain.com/api/auth/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Public URL of the app (used for OAuth redirect URIs - no trailing slash)
# Example: https://wantokjobs.com
APP_URL=


# ═══════════════════════════════════════════════════════════════
# SECTION: Additional Required Variables (added by audit)
# ═══════════════════════════════════════════════════════════════

# ─── WhatsApp Meta Cloud API ───────────────────────────────────────────────────
# Get from Meta Business Manager → WhatsApp → API Setup
WHATSAPP_TOKEN=your_permanent_whatsapp_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_WABA_ID=your_whatsapp_business_account_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token


# ─── AI Provider API Keys ──────────────────────────────────────────────────────
# Google Gemini (free tier): https://aistudio.google.com/app/apikey
GOOGLE_AI_KEY=your_google_ai_key

# NVIDIA NIM / Kimi K2 (free tier): https://integrate.api.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key

# Groq (free tier): https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# OpenRouter (free models): https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key

# Cohere (embeddings, free tier): https://dashboard.cohere.com
COHERE_API_KEY=your_cohere_api_key


# ─── Cron / Admin Automation ───────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_CRON_TOKEN=your_admin_cron_secret_token


# ─── 2FA / TOTP ────────────────────────────────────────────────────────────────
# Optional: enforce 2FA for admin roles
TWO_FA_REQUIRED_ROLES=admin
# TOTP issuer name shown in authenticator apps
TOTP_ISSUER=WantokJobs


# ─── Email Mode ────────────────────────────────────────────────────────────────
# Set to 'live' to enable real email sends (default: test)
EMAIL_MODE=test

